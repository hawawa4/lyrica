---
// Interactive illustration of the practice workflow. It is a hand-drawn mock
// (generated staff, WebAudio clicks) — not the real app and not real playback.
const MEASURES = 8
const PER_ROW = 4
const W = 200 // measure width
const ROW_H = 120
const TOP = 46
const step = 7 // px per staff step (half a line gap)
// A fixed little melody: staff steps above the bottom line, 4 quarter notes/measure.
const melody = [
  [0, 2, 4, 2], [4, 5, 7, 5], [7, 5, 4, 2], [0, 2, 4, 0],
  [4, 4, 5, 7], [9, 7, 5, 4], [5, 4, 2, 4], [2, 0, 0, 0],
]
const measures = Array.from({ length: MEASURES }, (_, i) => {
  const row = Math.floor(i / PER_ROW)
  const x = (i % PER_ROW) * W + 20
  const y = TOP + row * ROW_H
  const notes = melody[i].map((s, n) => {
    const nx = x + 30 + n * 42
    const ny = y + 4 * 2 * step - s * step
    return { nx, ny, up: s < 5 }
  })
  return { i, x, y, notes }
})
---

<section id="demo" class="demo-section">
  <div class="wrap">
    <h2>Try the practice loop</h2>
    <p class="lede">
      <strong>Drag across bars</strong> to select a passage, press play, and it repeats until you stop.
      Slow it down, turn on the click. This is an illustration of the workflow, not the real app.
    </p>

    <div class="demo" id="demo-root" data-theme="paper">
      <div class="bar">
        <div class="group">
          <button id="d-play" class="primary" aria-label="Play">▶ Play</button>
          <button id="d-stop" aria-label="Stop">■ Stop</button>
        </div>
        <div class="group" role="group" aria-label="Speed">
          <button class="speed" data-speed="0.5" aria-pressed="false">0.5×</button>
          <button class="speed" data-speed="0.75" aria-pressed="false">0.75×</button>
          <button class="speed" data-speed="1" aria-pressed="true">1×</button>
        </div>
        <label class="check"><input id="d-metro" type="checkbox" /> Metronome</label>
        <div class="group right" role="group" aria-label="Demo theme">
          <button class="theme" data-theme="light" aria-pressed="false">Light</button>
          <button class="theme" data-theme="dark" aria-pressed="false">Dark</button>
          <button class="theme" data-theme="paper" aria-pressed="true">Paper</button>
        </div>
      </div>

      <svg id="d-score" viewBox={`0 0 ${PER_ROW * W + 40} ${TOP + 2 * ROW_H - 30}`} role="img"
           aria-label="Eight bars of sheet music. Drag to select bars to loop.">
        {measures.map((m) => (
          <g class="m" data-i={m.i}>
            <rect class="hit" x={m.x} y={m.y - 26} width={W} height={ROW_H - 20} tabindex="0"
                  role="button" aria-label={`Bar ${m.i + 1}`} />
            <rect class="hl" x={m.x} y={m.y - 14} width={W} height={8 * step + 28} />
            <text class="num" x={m.x + 4} y={m.y - 18}>{m.i + 1}</text>
            {[0, 1, 2, 3, 4].map((l) => (
              <line class="staff" x1={m.x} x2={m.x + W} y1={m.y + l * 2 * step} y2={m.y + l * 2 * step} />
            ))}
            <line class="staff" x1={m.x + W} x2={m.x + W} y1={m.y} y2={m.y + 8 * step} />
            {m.notes.map((n) => (
              <g>
                <ellipse class="note" cx={n.nx} cy={n.ny} rx="6" ry="4.4" transform={`rotate(-20 ${n.nx} ${n.ny})`} />
                <line class="stem" x1={n.up ? n.nx + 5.4 : n.nx - 5.4} x2={n.up ? n.nx + 5.4 : n.nx - 5.4}
                      y1={n.ny} y2={n.up ? n.ny - 30 : n.ny + 30} />
              </g>
            ))}
          </g>
        ))}
        <line class="staff" x1="20" x2="20" y1={TOP} y2={TOP + 8 * step} />
        <line class="staff" x1="20" x2="20" y1={TOP + ROW_H} y2={TOP + ROW_H + 8 * step} />
        <line id="d-cursor" class="cursor" x1="0" x2="0" y1="0" y2="0" />
      </svg>

      <p class="status" id="d-status" aria-live="polite">No loop selected — playback runs through all 8 bars.</p>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById('demo-root') as HTMLElement
  const svg = document.getElementById('d-score') as unknown as SVGSVGElement
  const cursor = document.getElementById('d-cursor') as unknown as SVGLineElement
  const playBtn = document.getElementById('d-play') as HTMLButtonElement
  const stopBtn = document.getElementById('d-stop') as HTMLButtonElement
  const metro = document.getElementById('d-metro') as HTMLInputElement
  const status = document.getElementById('d-status') as HTMLElement
  const groups = Array.from(svg.querySelectorAll<SVGGElement>('.m'))

  const N = groups.length
  const BPM = 96
  const BEATS = 4
  const geo = groups.map((g) => {
    const r = g.querySelector<SVGRectElement>('.hl')!
    return { x: +r.getAttribute('x')!, w: +r.getAttribute('width')!, y: +r.getAttribute('y')!, h: +r.getAttribute('height')! }
  })

  let sel: [number, number] | null = null
  let anchor: number | null = null
  let speed = 1
  let playing = false
  let pos = 0 // in bars, fractional
  let last = 0
  let lastBeat = -1
  let raf = 0
  let audio: AudioContext | null = null

  function paintSelection() {
    groups.forEach((g, i) => g.classList.toggle('sel', !!sel && i >= sel[0] && i <= sel[1]))
    status.textContent = sel
      ? sel[0] === sel[1]
        ? `Looping bar ${sel[0] + 1}.`
        : `Looping bars ${sel[0] + 1}–${sel[1] + 1}.`
      : `No loop selected — playback runs through all ${N} bars.`
  }

  function paintCursor() {
    const i = Math.min(N - 1, Math.floor(pos))
    const g = geo[i]
    const x = g.x + (pos - i) * g.w
    cursor.setAttribute('x1', String(x))
    cursor.setAttribute('x2', String(x))
    cursor.setAttribute('y1', String(g.y + 8))
    cursor.setAttribute('y2', String(g.y + g.h - 8))
    cursor.style.opacity = '1'
    groups.forEach((gr, k) => gr.classList.toggle('now', playing && k === i))
  }

  function click(accent: boolean) {
    if (!audio) return
    const t = audio.currentTime
    const osc = audio.createOscillator()
    const gain = audio.createGain()
    osc.frequency.value = accent ? 1500 : 1000
    gain.gain.setValueAtTime(0.0001, t)
    gain.gain.exponentialRampToValueAtTime(0.25, t + 0.002)
    gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.05)
    osc.connect(gain).connect(audio.destination)
    osc.start(t)
    osc.stop(t + 0.06)
  }

  function tick(now: number) {
    const dt = (now - last) / 1000
    last = now
    const barSeconds = (BEATS * 60) / BPM / speed
    const lo = sel ? sel[0] : 0
    const hi = sel ? sel[1] + 1 : N
    pos += dt / barSeconds
    if (pos >= hi) pos = lo + ((pos - lo) % (hi - lo))
    if (pos < lo) pos = lo
    const beat = Math.floor(pos * BEATS)
    if (beat !== lastBeat) {
      lastBeat = beat
      if (metro.checked) click(beat % BEATS === 0)
    }
    paintCursor()
    raf = requestAnimationFrame(tick)
  }

  function play() {
    if (metro.checked && !audio) audio = new AudioContext()
    if (audio?.state === 'suspended') void audio.resume()
    const lo = sel ? sel[0] : 0
    if (!playing && (pos < lo || (sel && pos >= sel[1] + 1))) pos = lo
    playing = true
    last = performance.now()
    lastBeat = -1
    playBtn.textContent = '❚❚ Pause'
    cancelAnimationFrame(raf)
    raf = requestAnimationFrame(tick)
  }
  function pause() {
    playing = false
    cancelAnimationFrame(raf)
    playBtn.textContent = '▶ Play'
    paintCursor()
  }
  function stop() {
    playing = false
    cancelAnimationFrame(raf)
    playBtn.textContent = '▶ Play'
    pos = sel ? sel[0] : 0
    cursor.style.opacity = '0'
    groups.forEach((g) => g.classList.remove('now'))
  }

  playBtn.addEventListener('click', () => (playing ? pause() : play()))
  stopBtn.addEventListener('click', stop)
  metro.addEventListener('change', () => {
    if (metro.checked && !audio) audio = new AudioContext()
  })

  root.querySelectorAll<HTMLButtonElement>('.speed').forEach((b) =>
    b.addEventListener('click', () => {
      speed = Number(b.dataset.speed)
      root.querySelectorAll('.speed').forEach((o) => o.setAttribute('aria-pressed', String(o === b)))
    }),
  )
  root.querySelectorAll<HTMLButtonElement>('.theme').forEach((b) =>
    b.addEventListener('click', () => {
      root.dataset.theme = b.dataset.theme
      root.querySelectorAll('.theme').forEach((o) => o.setAttribute('aria-pressed', String(o === b)))
    }),
  )

  function barAt(e: PointerEvent): number | null {
    const el = document.elementFromPoint(e.clientX, e.clientY)
    const g = el?.closest('.m') as SVGGElement | null
    return g ? Number(g.dataset.i) : null
  }
  const range = (a: number, b: number): [number, number] => [Math.min(a, b), Math.max(a, b)]

  svg.addEventListener('pointerdown', (e) => {
    const i = barAt(e)
    if (i === null) {
      sel = null
      anchor = null
      paintSelection()
      return
    }
    anchor = i
    sel = [i, i]
    paintSelection()
    svg.setPointerCapture(e.pointerId)
  })
  svg.addEventListener('pointermove', (e) => {
    if (anchor === null) return
    const i = barAt(e)
    if (i !== null) {
      sel = range(anchor, i)
      paintSelection()
    }
  })
  const endDrag = () => {
    anchor = null
    if (sel && playing && (pos < sel[0] || pos >= sel[1] + 1)) pos = sel[0]
  }
  svg.addEventListener('pointerup', endDrag)
  svg.addEventListener('pointercancel', endDrag)

  // Keyboard: Enter selects a bar, Shift+Enter extends the selection.
  svg.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return
    const g = (e.target as Element).closest('.m') as SVGGElement | null
    if (!g) return
    const i = Number(g.dataset.i)
    sel = e.shiftKey && sel ? range(sel[0], i) : [i, i]
    paintSelection()
  })
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sel) {
      sel = null
      paintSelection()
    }
  })
</script>

<style>
  .demo-section { padding: 4rem 0; }
  .lede { max-width: 42rem; color: var(--muted); margin: 0.75rem 0 1.5rem; }
  .demo {
    /* Demo-scoped palette so the Light/Dark/Paper switch only affects the mock app. */
    --d-bg: #f6efe0; --d-bar: #ebe2cf; --d-ink: #2b2118; --d-line: #d8cbb2; --d-hl: rgba(184, 84, 26, 0.16);
    --d-cur: #b8541a; --d-btn: #fffaf0;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: var(--d-bg);
    color: var(--d-ink);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }
  .demo[data-theme='light'] { --d-bg: #ffffff; --d-bar: #f1f1f1; --d-ink: #1b1b1b; --d-line: #d4d4d4; --d-hl: rgba(20, 100, 220, 0.14); --d-cur: #1464dc; --d-btn: #fff; }
  .demo[data-theme='dark'] { --d-bg: #1d1f23; --d-bar: #282b31; --d-ink: #e8e6e1; --d-line: #3a3e46; --d-hl: rgba(240, 170, 80, 0.2); --d-cur: #f0aa50; --d-btn: #31353d; }
  .bar {
    display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: center;
    padding: 0.6rem 0.8rem; background: var(--d-bar); border-bottom: 1px solid var(--d-line);
    font-size: 0.9rem;
  }
  .group { display: flex; gap: 0.3rem; }
  .group.right { margin-left: auto; }
  .bar button {
    font: inherit; color: inherit; cursor: pointer;
    background: var(--d-btn); border: 1px solid var(--d-line); border-radius: 6px; padding: 0.3rem 0.7rem;
  }
  .bar button.primary { background: var(--d-cur); color: var(--d-bg); border-color: var(--d-cur); font-weight: 600; min-width: 5.5rem; }
  .bar button[aria-pressed='true'] { outline: 2px solid var(--d-cur); outline-offset: -2px; }
  .check { display: flex; align-items: center; gap: 0.35rem; cursor: pointer; }
  svg { display: block; width: 100%; height: auto; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .staff { stroke: var(--d-ink); stroke-width: 1; opacity: 0.75; }
  .note { fill: var(--d-ink); }
  .stem { stroke: var(--d-ink); stroke-width: 1.4; }
  .num { fill: var(--d-ink); opacity: 0.55; font: 11px var(--sans); }
  .hl { fill: var(--d-hl); opacity: 0; pointer-events: none; }
  .m.sel .hl { opacity: 1; }
  .m.now .num { opacity: 1; font-weight: 700; fill: var(--d-cur); }
  .hit { fill: transparent; cursor: pointer; outline: none; }
  .hit:focus-visible { stroke: var(--d-cur); stroke-width: 2; stroke-dasharray: 4 3; }
  .cursor { stroke: var(--d-cur); stroke-width: 2.5; opacity: 0; pointer-events: none; }
  .status { margin: 0; padding: 0.5rem 0.9rem; font-size: 0.85rem; border-top: 1px solid var(--d-line); background: var(--d-bar); }
</style>
