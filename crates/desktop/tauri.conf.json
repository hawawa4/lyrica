{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyrica",
  "version": "1.0.0",
  "identifier": "org.hawawa.lyrica",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../web"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../web"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lyrica",
        "width": 1100,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": {
      "../../assets/FluidR3_GM.sf2": "FluidR3_GM.sf2"
    },
    "shortDescription": "Sheet-music practice app for MuseScore files",
    "longDescription": "Sheet-music practice app for MuseScore files",
    "category": "Education",
    "homepage": "https://lyrica.hawawa.org",
    "publisher": "me@hawawa.org",
    "linux": {
      "deb": {
        "section": "sound"
      }
    }
  }
}
